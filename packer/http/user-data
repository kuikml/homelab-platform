#cloud-config
autoinstall:
  version: 1
  identity:
    hostname: ubuntu-template
    username: ubuntu
    password: "$6$2YVtSj4LJn/HjE8w$5JXLIGbKipia2D5qVXGYq8inDSqpAlFYYCR6wpxa2rbfn9HXphWJl4Bf3yD0b6pbkaP6ZVpCI8dmdIyQM/.UO1"
  locale: en_US.UTF-8
  keyboard:
    layout: us
  ssh:
    install-server: true
    allow-pw: true
    disable_root: false
    ssh_quiet_keygen: true
    allow_public_ssh_keys: true
    authorized-keys:
      - "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIDSsB0vmqGpBesSVBPXvgPZ9ZbDcbuY18mDXfv9EBdAD root@packer-runner"
  packages:
    - qemu-guest-agent
    - cloud-init
    - sudo
  storage:
    layout:
      name: direct
  user-data:
    users:
      - name: ubuntu
        groups: [sudo]
        sudo: ALL=(ALL) NOPASSWD:ALL
        shell: /bin/bash
        ssh_authorized_keys:
          - "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIDSsB0vmqGpBesSVBPXvgPZ9ZbDcbuY18mDXfv9EBdAD root@packer-runner"
  late-commands:
    - echo "ubuntu ALL=(ALL) NOPASSWD:ALL" >> /target/etc/sudoers.d/ubuntu
    - chmod 440 /target/etc/sudoers.d/ubuntu
    - curtin in-target --target=/target -- apt-get install -y qemu-guest-agent cloud-init sudo
    - curtin in-target --target=/target -- systemctl enable qemu-guest-agent